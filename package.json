{
  "name": "tidysum",
  "version": "0.0.0",
  "private": true,
  "description": "The wealth manager's playbook without the wealth manager's fee: a self-hosted money hub that finds money in the wrong place, prices it per year, and lets your own AI agent fix what you approve.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "tidysum": "tsx --env-file-if-exists=.env src/cli.ts",
    "demo": "tsx src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "big.js": "^7.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "plaid": "^49.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.11.0-beta.19",
    "@embedded-postgres/darwin-x64": "17.11.0-beta.19",
    "@embedded-postgres/linux-arm64": "17.11.0-beta.19",
    "@embedded-postgres/linux-x64": "17.11.0-beta.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
