# Copy to .env and fill in. Never commit .env.
# Empty: Tidysum runs its own PostgreSQL in ~/.tidysum/postgres (TIDYSUM_HOME), no Docker needed.
# For docker compose's Postgres instead: postgres://tidysum:tidysum@localhost:5432/tidysum
DATABASE_URL=

# Plaid: free account at dashboard.plaid.com (Trial plan: up to 10 real connections).
# Keys: Developers -> Keys. Use production + the Production secret for your real accounts.
# Step by step: docs/connect-your-accounts.md
# No Plaid account? SimpleFIN Bridge needs nothing here: paste its setup token on Connections.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# UK and EU banks, which Plaid's free plan doesn't reach: Enable Banking's free mode for your own
# accounts. Leave empty in the US and Canada. Step by step: docs/connect-your-accounts.md
ENABLE_BANKING_APP_ID=
# The private key Enable Banking downloaded when you registered the application (<app id>.pem).
ENABLE_BANKING_KEY_FILE=
# The redirect URL registered with the application. Production needs https, so a local Tidysum
# registers https://lucidity-finance.github.io/tidysum/bank-callback.html, which sends you back to
# 127.0.0.1. Empty: Tidysum's own /enable-banking/callback (fine for Enable Banking's sandbox).
ENABLE_BANKING_REDIRECT_URL=
# true only if your Plaid team has Plaid's European production access.
PLAID_EUROPE=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key means re-linking every Item.
TIDYSUM_TOKEN_KEY=

# Which user commands act for. Unset means the only user (a fresh install has one).
TIDYSUM_USER_ID=
# Deposit product rates for `tidysum products`; default catalog/deposit-products.json.
TIDYSUM_PRODUCTS_FILE=
# Credit card terms for `tidysum cards`; default catalog/credit-cards.json.
TIDYSUM_CARDS_FILE=

# tidysum serve
# HTTP Basic password for the admin page (any username), required only when HOST is not
# loopback. On 127.0.0.1 the page has no sign-in. openssl rand -base64 32
TIDYSUM_ADMIN_TOKEN=
# Public https origin, so Plaid can send webhooks. Leave empty for local use.
TIDYSUM_PUBLIC_URL=
# Bearer token for agents at /mcp (openssl rand -base64 32). Empty turns /mcp off.
TIDYSUM_MCP_TOKEN=
# Your written plan (Markdown), reloaded by deploy/macos-setup.sh. See README "Your plan".
TIDYSUM_PLAN_FILE=
# Who Tidysum names to the SEC when it fetches fund fees: your name and email. Empty: the
# project's public contact.
TIDYSUM_SEC_USER_AGENT=
# investment-miner's directory, for the research sleeve (README "Research sleeve"). Empty: off.
TIDYSUM_MINER_DIR=
# Path to uv, if not in ~/.local/bin, Homebrew or on PATH; and hours between reads (default 1).
TIDYSUM_MINER_UV=
TIDYSUM_MINER_INTERVAL_HOURS=
# investment-miner's API, which runs scans for the "Scan now" button (default http://127.0.0.1:8000).
TIDYSUM_MINER_URL=
# Scheduled actions (decision 0006). How serve tells you an action came due: macos (a
# notification; the default on a Mac), log, or off.
TIDYSUM_NOTIFY=
# Your own agent, as a shell command, which serve starts on an approved action the day it comes
# due, with TIDYSUM_ACTION_ID and TIDYSUM_ACTION_PROMPT set. Empty: you're only told. Example
# (the prompt goes right after -p: --allowedTools takes every word after it as a tool name):
# TIDYSUM_AGENT_COMMAND='"$HOME/.local/bin/claude" -p "$TIDYSUM_ACTION_PROMPT" --chrome --allowedTools "mcp__tidysum,mcp__claude-in-chrome"'
TIDYSUM_AGENT_COMMAND=
# Local hours it may start your agent in, from-to (default 8-21).
TIDYSUM_AGENT_HOURS=
HOST=127.0.0.1
PORT=8080
SYNC_INTERVAL_MINUTES=360
SYNC_RETRY_MINUTES=30
